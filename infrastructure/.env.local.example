# This file is a TEMPLATE for local Docker Desktop dev. The `local-up.ps1` script copies it to `.env.local` and auto-generates random values for the `<generate-random>` placeholders. `.env.local` is gitignored.

# Local host ports: one consecutive high-numbered block avoids common defaults.
WEB_PORT=4780
CMS_PORT=4781
DB_PORT=4782
PROXY_HTTP_PORT=4783
PROXY_HTTPS_PORT=4784
PROXY_DASHBOARD_PORT=4785

# Local origins and internal Docker DNS
NEXT_PUBLIC_SITE_URL=http://localhost:4780
DOMAIN=localhost
CMS_INTERNAL_URL=http://cms:1337

# Web service tokens (server-side only)
STRAPI_API_TOKEN=<generate-random>
REVALIDATE_SECRET=<generate-random>
NEXT_PUBLIC_FEATURE_LEAD_FORM=off

# Retained for parity with the production contract; local Traefik does not use ACME.
LETSENCRYPT_EMAIL=admin@landing.ene-muebles.cl

# Strapi application secrets (server-side only)
APP_KEYS=<generate-random>
API_TOKEN_SALT=<generate-random>
ADMIN_JWT_SECRET=<generate-random>
TRANSFER_TOKEN_SALT=<generate-random>
JWT_SECRET=<generate-random>

# Local MySQL credentials
MYSQL_DATABASE=landing_local
MYSQL_USER=landing_local
MYSQL_PASSWORD=<generate-random>
MYSQL_ROOT_PASSWORD=<generate-random>
