# Strapi application environment contract
#
# Copy to `.env` (or load via Coolify's Environment UI) and generate every
# secret before production startup. `.env` is ignored by `.gitignore`; only
# `.env.example` is tracked.

# Server — bind 0.0.0.0 so the container accepts traffic from the
# internal Docker network and from the on-host healthcheck.
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=
# Comma-separated browser origins allowed to call the CMS API. The Compose
# production contract requires this value; local development falls back to the
# localhost origins declared in config/middlewares.ts.
CORS_ORIGINS=https://ene-muebles.cl,https://www.ene-muebles.cl

# Secrets — APP_KEYS holds four comma-separated slots
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
# Required to establish the dedicated Strapi Super Admin before Editor seeding.
# Use a unique email and a generated password with 16+ characters, lowercase,
# uppercase, numeric, and symbol characters.
STRAPI_BOOTSTRAP_SUPER_ADMIN_EMAIL=
STRAPI_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Required to create the initial client Editor account; no fallback is used.
# Use a generated password with the same 16-character, four-class policy.
CLIENT_ADMIN_PASSWORD=

# Database — MySQL via the `db` service on the internal network
DATABASE_CLIENT=mysql
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false

NODE_ENV=production
