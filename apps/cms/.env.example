# Strapi application environment contract
#
# Copy to `.env` (or load via Coolify's Environment UI) and replace every
# `CHANGE_ME` placeholder with a real value. `.env` is ignored by
# `.gitignore`; only `.env.example` is tracked.

# Server — bind 0.0.0.0 so the container accepts traffic from the
# internal Docker network and from the on-host healthcheck.
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=

# Secrets — APP_KEYS holds four comma-separated slots
APP_KEYS=CHANGE_ME,CHANGE_ME,CHANGE_ME,CHANGE_ME
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Required to create the initial client Editor account; no fallback is used.
CLIENT_ADMIN_PASSWORD=CHANGE_ME

# Database — MySQL via the `db` service on the internal network
DATABASE_CLIENT=mysql
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=CHANGE_ME
DATABASE_USERNAME=CHANGE_ME
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSL=false

NODE_ENV=production
