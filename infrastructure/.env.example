# Coolify deployment environment contract
#
# Copy to `.env` (or load via Coolify's Environment UI). Generate the app and
# database secrets before deployment. Strapi-issued tokens are added only after
# the first CMS bootstrap. `.env` is ignored by `.gitignore`; only
# `.env.example` is tracked.

# Public origin
NEXT_PUBLIC_SITE_URL=https://landing.ene-muebles.cl
# Host routed by Coolify only for Strapi's public `/api` and `/uploads` paths.
CMS_PUBLIC_HOSTNAME=cms.ene-muebles.cl
# Internal Docker DNS for the Next.js server to reach Strapi.
STRAPI_INTERNAL_URL=http://cms:1337
# Browser-reachable origin used only for Strapi media URLs. Do not set this
# to the internal Docker hostname above.
NEXT_PUBLIC_STRAPI_URL=https://cms.ene-muebles.cl

# Web service tokens (server-side only). These are issued from Strapi Admin
# after first startup; never generate arbitrary values. STRAPI_API_TOKEN is
# optional when Public permissions allow catalog reads. STRAPI_ADMIN_TOKEN is
# required to use the protected Next.js admin operations.
STRAPI_API_TOKEN=
STRAPI_ADMIN_TOKEN=
REVALIDATE_SECRET=
ADMIN_SESSION_SECRET=
# `on` once the operator is ready to accept inbound leads.
NEXT_PUBLIC_FEATURE_LEAD_FORM=off

# Strapi application secrets (server-side only)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
# Required only when bootstrapping the client Editor user.
CLIENT_ADMIN_PASSWORD=

# MySQL credentials (private network only)
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
