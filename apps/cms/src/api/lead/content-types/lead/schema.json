{
  "kind": "collectionType",
  "collectionName": "leads",
  "info": {
    "singularName": "lead",
    "pluralName": "leads",
    "displayName": "Lead",
    "description": "Inquiry submitted through the public contact form. PRIVATE content type: it is intentionally NOT listed in SCOPED_TYPES in src/index.ts, so the Public role never receives find/findOne permissions and the REST API denies every anonymous read/write. Records are written only by the Next.js /api/leads route with the admin-scoped token."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 200
    },
    "institution": {
      "type": "string",
      "maxLength": 280
    },
    "email": {
      "type": "email",
      "required": true,
      "maxLength": 200
    },
    "phone": {
      "type": "string",
      "maxLength": 40
    },
    "region": {
      "type": "string",
      "maxLength": 80
    },
    "message": {
      "type": "text",
      "required": true,
      "maxLength": 2000
    },
    "consent": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "consentVersion": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "source": {
      "type": "string",
      "required": true,
      "default": "contact-form",
      "maxLength": 40
    },
    "product": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "notified",
        "failed"
      ],
      "default": "new",
      "required": true
    },
    "idempotencyKey": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 64
    }
  }
}
