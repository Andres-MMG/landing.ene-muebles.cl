{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Furniture product shown in the public catalog."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "maxLength": 280
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "currency": {
      "type": "string",
      "default": "CLP",
      "maxLength": 4
    },
    "dimensions": {
      "type": "json"
    },
    "materials": {
      "type": "json"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "externalId": {
      "type": "string",
      "unique": true,
      "sparse": true,
      "maxLength": 32
    },
    "productType": {
      "type": "string",
      "enum": [
        "Silla",
        "Mesa",
        "Escritorio",
        "Banca",
        "Piso",
        "Cuna"
      ]
    },
    "subcategory": {
      "type": "string",
      "maxLength": 80
    },
    "usageEnvironment": {
      "type": "string",
      "maxLength": 120
    },
    "observableColor": {
      "type": "string",
      "maxLength": 120
    },
    "observableMaterial": {
      "type": "string",
      "maxLength": 160
    },
    "catalogPage": {
      "type": "integer",
      "min": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "alta",
        "media-variante-visual",
        "media-nombre-generico-pdf",
        "baja",
        "revision-manual"
      ]
    },
    "source": {
      "type": "string",
      "maxLength": 200
    },
    "observation": {
      "type": "text"
    },
    "importSource": {
      "type": "enumeration",
      "enum": [
        "manual",
        "imported"
      ],
      "default": "manual"
    },
    "importBatch": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::import-batch.import-batch",
      "inversedBy": "importedProducts"
    }
  }
}
