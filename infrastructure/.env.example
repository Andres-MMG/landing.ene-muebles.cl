# Coolify deployment environment contract
#
# Copy to `.env` (or load via Coolify's Environment UI) and replace every
# `CHANGE_ME` placeholder with a real value. `.env` is ignored by
# `.gitignore`; only `.env.example` is tracked.

# Public origin
NEXT_PUBLIC_SITE_URL=https://landing.ene-muebles.cl
DOMAIN=landing.ene-muebles.cl
# Internal Docker DNS for the Next.js server to reach Strapi.
CMS_INTERNAL_URL=http://cms:1337

# Web service tokens (server-side only)
STRAPI_API_TOKEN=CHANGE_ME
REVALIDATE_SECRET=CHANGE_ME
# `on` once the operator is ready to accept inbound leads.
NEXT_PUBLIC_FEATURE_LEAD_FORM=off

# Let's Encrypt
LETSENCRYPT_EMAIL=admin@landing.ene-muebles.cl

# Strapi application secrets (server-side only)
APP_KEYS=CHANGE_ME,CHANGE_ME,CHANGE_ME,CHANGE_ME
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME

# MySQL credentials (private network only)
MYSQL_DATABASE=CHANGE_ME
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
